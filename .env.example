# =============================================================
# Nexora — environment variable reference
# All values below are placeholders. Never commit real secrets.
# Copy to `.env` (backend loads it via dotenv) and adjust.
# =============================================================

# --- Backend ---
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Deployment safety profile: development, lan, or hardened.
# `lan` is intended for a firewall-restricted private network and permits HTTP.
DEPLOYMENT_PROFILE=lan
# Compose binds to loopback by default. Set 0.0.0.0 only when the host firewall
# restricts port 3000 to your trusted LAN or management VLAN.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3000

# Directory for the SQLite database, history, backups and secrets
DATA_DIR=./data

# true = simulated telemetry (default). false = live Proxmox VE data.
MOCK_MODE=false
# Explicit disposable-demo behavior. When true, an existing admin password is
# reset to homelab-demo at startup. Allowed only in the development profile.
DEMO_RESET_ADMIN=false

# Simulation tick / WebSocket push cadence (ms)
TELEMETRY_INTERVAL_MS=2000
# Seeded history retention window (hours)
HISTORY_RETENTION_HOURS=24

# --- Proxmox VE provider (MOCK_MODE=false) ---
# Host of the Proxmox API, with port if non-standard (https://<host>:8006)
PROXMOX_HOST=
# API token ID, format: '<user>@<realm>!<tokenname>' (e.g. root@pam!homelab)
PROXMOX_TOKEN_ID=
# API token secret (show once when creating the token in Proxmox)
PROXMOX_TOKEN_SECRET=
# Proxmox uses self-signed certs by default. 'true' validates the TLS chain.
PROXMOX_VERIFY_TLS=true
# How often the backend polls Proxmox (ms)
PROXMOX_POLL_INTERVAL_MS=5000

# Docker telemetry is collected by Nexora Agent on the monitored host.
# Legacy direct-provider support is opt-in; the dashboard has no socket mount.
DOCKER_ENABLED=false

# Preserve the existing volume name across directory/repository renames.
# Set this to your actual existing volume before upgrading a custom deployment.
NEXORA_DATA_VOLUME=homelab-os_homelab-data

# Encrypts stored secrets (integration credentials, recovery email).
# Set to a long random string. If empty, a key is derived and stored
# under DATA_DIR (regenerated if DATA_DIR is wiped).
SECRET_ENCRYPTION_KEY=

# On first boot the super admin is created with this password.
# If empty, a random password is generated and written to
# DATA_DIR/.admin-initial-password.
ADMIN_INITIAL_PASSWORD=

# Set true when the browser reaches the dashboard through HTTPS.
COOKIE_SECURE=false
NODE_ENV=production

# --- SMTP Configuration (Professional Setup) ---
# Configure these variables to automatically provision email settings on boot.
# Enables account recovery and two-factor authentication via email.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Nexora <your-email@gmail.com>

# --- Frontend (build-time / dev) ---
# API base path for the SPA (nginx proxies /api -> backend)
VITE_BACKEND_URL=/api
# WebSocket endpoint (defaults to ws(s)://<host>/ws)
VITE_WS_URL=
